{
  "name": "classic-game-box",
  "private": true,
  "version": "0.1.3",
  "description": "Classic Game Box - NES / FC emulator, Electron front end. The emulator itself is in ../packages/fc-core/src, compiled to WebAssembly.",
  "author": "Classic Game Box",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "wasm": "bash ../wasm/build.sh",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:native": "node scripts/build-native.mjs",
    "build": "pnpm run build:main && pnpm run build:renderer && pnpm run build:native",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:native": "cmake -S native/gamepad-cpp -B native/gamepad-cpp/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/gamepad-cpp/build --config Release && ctest --test-dir native/gamepad-cpp/build -C Release --output-on-failure",
    "dev": "node scripts/dev.mjs",
    "dev:gamepad": "node scripts/dev.mjs --gamepad",
    "start": "pnpm run build && electron .",
    "selftest": "pnpm run build && electron . --selftest 300 --dump selftest.png",
    "keytest": "pnpm run build && electron . --keytest",
    "audiotest": "pnpm run build && electron . --audiotest 8",
    "gamepad": "pnpm run build && electron . --gamepad",
    "gamepad:browser": "pnpm run build && electron . --browser-gamepad",
    "pack": "pnpm run build && electron-builder --mac dir",
    "dist": "pnpm run build && electron-builder --mac dmg",
    "pack:win": "pnpm run build && electron-builder --win dir",
    "dist:win": "pnpm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.classicgamebox.electron",
    "productName": "Classic Game Box",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native/bin"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Classic Game Box"
    }
  },
  "devDependencies": {
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
