# npm
node_modules/

# Build output
dist/
dist-electron/

# `npm run selftest` writes a picture here so a human can look at it.
selftest.png

# electron/verify.sh scratch space
.verify/

# electron-builder's resource folder (build/) is source: the app icon lives
# there and a clean clone must be able to package without macOS tools. Only
# the iconset that `pnpm run icon` eats is a build product.
build/icon.iconset/

# The Swift helper: its build directory and the copied binary. Both are
# produced by `pnpm run build:native` and neither is source.
native/gamepad/.build/
native/gamepad-cpp/build/
native/bin/

# electron-builder output: the .app, the .dmg and the block map.
release/
