# Build output.
/target/

# ---------------------------------------------------------------------------
# Native libretro cores. Built on demand by cores/*/build.sh; the sources are
# third-party clones and the dylibs are build products, so neither is tracked.
# ---------------------------------------------------------------------------
/cores/dist/
/cores/sources/
/cores/**/*.dylib
/cores/**/*.o
/cores/**/*.a

# Mesen / mGBA Makefile leftovers.
/cores/sources/**/*.bc

# ---------------------------------------------------------------------------
# Cores fetched at runtime into the app data dir are not in the repo at all;
# ROMs and saves are never committed (copyright + size).
# ---------------------------------------------------------------------------
*.nes
*.gba
*.gb
*.gbc
*.srm
*.state

# macOS
.DS_Store
._*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Legacy outputs (the old CMake / Emscripten / Electron trees moved to legacy/;
# if anyone builds them in place, keep the junk out of git).
/legacy/build/
/legacy/build-*/
/legacy/wasm/dist/
/legacy/electron/node_modules/
/legacy/electron/dist/
/legacy/electron/dist-electron/
/legacy/electron/release/
/legacy/third_party/emsdk/
frames/
