# Build output.
/target/
/build/
/dist/
/.vscode/
# ---------------------------------------------------------------------------
# Native libretro cores. Built on demand by cores/*/build.sh; the sources are
# third-party clones and the dylibs are build products, so neither is tracked.
# ---------------------------------------------------------------------------
/cores/dist/
/cores/sources/
/cores/**/*.dylib
/cores/**/*.o
/cores/**/*.a

# Mesen / mGBA Makefile leftovers.
/cores/sources/**/*.bc

# ---------------------------------------------------------------------------
# Cores fetched at runtime into the app data dir are not in the repo at all;
# game ROMs and saves are never committed (copyright + size). The arcade BIOS
# under assets/roms/ is the deliberate exception: small, bundled with the app,
# and seeded into the writable system dir at startup (see assets/README.md).
# ---------------------------------------------------------------------------
*.nes
*.gba
*.gb
*.gbc
*.srm
*.state

# macOS
.DS_Store
._*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Legacy tree: only the custom FC/NES core sources remain; ignore any in-place
# CMake build directories.
/custom_nes_core/build/
/custom_nes_core/build-*/
frames/

# GLideN64 shader cache written into the working directory by the N64 core.
/Mupen64plus/
**/Mupen64plus/
/ParallelN64/
**/ParallelN64/

# Experimental Swift/macOS client (SwiftPM).
/macos/.build/
